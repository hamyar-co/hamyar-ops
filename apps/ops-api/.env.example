# Application
NODE_ENV=development
PORT=3005
CORS_ORIGINS=http://localhost:3004,https://ops.hamyar.app

# Database (production: reuse existing postgres container)
DATABASE_URL="postgresql://opsuser:opspassword@localhost:5432/hamyar_ops"

# Redis (production: reuse existing redis container)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_ACCESS_SECRET=change-me-in-production-access
JWT_REFRESH_SECRET=change-me-in-production-refresh
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=604800

# CI deploy recording (GitHub Actions calls /applications/:name/deploy-record with this token)
DEPLOY_RECORD_TOKEN=change-me-ops-deploy-token

# SSH (target server — only needed for terminal)
SSH_HOST=91.220.113.171
SSH_PORT=22
SSH_USERNAME=root
SSH_KEY_PATH=/root/.ssh/id_rsa

# Nginx
NGINX_SITES_AVAILABLE=/etc/nginx/sites-available
NGINX_SITES_ENABLED=/etc/nginx/sites-enabled

# Docker
DOCKER_SOCKET=/var/run/docker.sock
DOCKER_COMPOSE_FILE=/opt/hamyar/backend/docker-compose.yml

# PM2
PM2_ECOSYSTEM_FILE=/opt/hamyar/ecosystem.config.js

# File Browser Allowlist (comma-separated)
FILE_BROWSER_ROOTS=/etc/nginx,/opt/hamyar,/var/log,/var/www

# Log Paths
LOG_PATH_HAMYAR=/var/log/hamyar
LOG_PATH_NGINX=/var/log/nginx
